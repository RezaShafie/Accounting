@page "/"

@inject NavigationManager NavManager
@inject IVoucherService VoucherService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8 mb-8">

    <MudText Typo="Typo.h4" Color="Color.Primary" Class="mb-4" Style="font-weight: 500;">
        <b>مدیریت اسناد</b>
    </MudText>

    <MudPaper Elevation="25" Class="pa-4" Style="border-radius: 12px; background-color: var(--mud-palette-surface);">
        <MudTable T="VoucherDto"
                  ServerData="@ServerReload"
                  Dense="true"
                  Hover="true"
                  Striped="true"
                  Bordered="false"
                  @ref="_table"
                  Loading="@_loading"
                  LoadingProgressColor="Color.Primary"
                  Elevation="0">

            <ToolBarContent>
                <div class="d-flex align-center flex-grow-1 gap-4">
                    <MudIcon Icon="@Icons.Material.TwoTone.ReceiptLong" Size="Size.Large" Color="Color.Primary" />
                    <MudText Typo="Typo.h6">لیست اسناد حسابداری</MudText>

                    <MudSpacer />

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="@(() => NavManager.NavigateTo("/vouchers/create"))">
                        سند جدید
                    </MudButton>
                </div>
            </ToolBarContent>

            <HeaderContent>
                <MudTh><MudTableSortLabel SortLabel="VoucherNumber" T="VoucherDto">شماره</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Date" T="VoucherDto">تاریخ</MudTableSortLabel></MudTh>
                <MudTh>شرح</MudTh>
                <MudTh>وضعیت</MudTh>
                <MudTh Style="text-align:center">عملیات</MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd DataLabel="شماره">
                    <MudText Typo="Typo.body2" Style="font-weight:bold">@context.VoucherNumber</MudText>
                </MudTd>
                <MudTd DataLabel="تاریخ">@context.Date.ToPersianDateString()</MudTd>
                <MudTd DataLabel="شرح">
                    <MudText Typo="Typo.body2" Style="max-width: 300px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                        @context.Description
                    </MudText>
                </MudTd>
                <MudTd DataLabel="وضعیت">
                    @if (context.IsFinalized)
                    {
                        <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Lock">قطعی</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Warning" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Filled.EditNote">پیش‌نویس</MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="عملیات" Style="text-align:center">

                    <MudTooltip Text="ویرایش" Arrow="true" Placement="Placement.Top">
                        <MudIconButton Icon="@Icons.Material.TwoTone.Edit"
                                       Size="Size.Small"
                                       Color="Color.Info"
                                       Disabled="@context.IsFinalized"
                                       OnClick="@(() => NavManager.NavigateTo($"/vouchers/edit/{context.Id}"))" />
                    </MudTooltip>

                    <MudTooltip Text="حذف" Arrow="true" Placement="Placement.Top">
                        <MudIconButton Icon="@Icons.Material.TwoTone.Delete"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       Disabled="@context.IsFinalized"
                                       OnClick="@(() => DeleteVoucher(context.Id, (int)context.VoucherNumber))" />
                    </MudTooltip>

                    <MudTooltip Text="نهایی سازی" Arrow="true" Placement="Placement.Top">
                        <MudIconButton Icon="@Icons.Material.TwoTone.CheckCircle"
                                       Size="Size.Small"
                                       Color="Color.Success"
                                       Disabled="@context.IsFinalized"
                                       OnClick="@(() => FinalizeVoucher(context.Id))" />
                    </MudTooltip>

                </MudTd>
            </RowTemplate>

            <NoRecordsContent>
                <MudStack AlignItems="AlignItems.Center" Class="py-8">
                    <MudIcon Icon="@Icons.Material.TwoTone.Note" Size="Size.Large" Color="Color.Default" />
                    <MudText Color="Color.Secondary">هیچ سندی یافت نشد.</MudText>
                </MudStack>
            </NoRecordsContent>

            <LoadingContent>
                <MudStack AlignItems="AlignItems.Center" Class="py-8">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                    <MudText Class="mt-2">در حال بارگذاری اطلاعات...</MudText>
                </MudStack>
            </LoadingContent>

            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }"
                               InfoFormat="{first_item}-{last_item} از {all_items}"
                               RowsPerPageString="تعداد در صفحه:" />
            </PagerContent>
        </MudTable>
    </MudPaper>
</MudContainer>

@code {
    private MudTable<VoucherDto> _table;
    private bool _loading = true;

    private async Task<TableData<VoucherDto>> ServerReload(TableState state, CancellationToken token)
    {
        _loading = true;
        try
        {
            var pageNumber = state.Page + 1;
            var pageSize = state.PageSize;

            // Uses existing simple get method (no search string)
            var result = await VoucherService.GetVouchersAsync(pageNumber, pageSize);

            return new TableData<VoucherDto>()
            {
                TotalItems = result.TotalCount,
                Items = result.Items
            };
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return new TableData<VoucherDto>() { TotalItems = 0, Items = new List<VoucherDto>() };
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task DeleteVoucher(Guid id, int voucherNumber)
    {
        var confirm = await DialogService.ShowMessageBox(
            "حذف سند",
            $"آیا از حذف سند شماره {voucherNumber} اطمینان دارید؟",
            yesText: "بله", cancelText: "خیر");

        if (confirm == true)
        {
            try
            {
                await VoucherService.DeleteVoucherAsync(id);
                Snackbar.Add("سند با موفقیت حذف شد.", Severity.Success);
                await _table.ReloadServerData();
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }

    private async Task FinalizeVoucher(Guid id)
    {
        var confirm = await DialogService.ShowMessageBox(
            "نهایی سازی",
            $"آیا از نهایی سازی سند اطمینان دارید؟ (این عملیات غیرقابل بازگشت است)",
            yesText: "بله", cancelText: "خیر");

        if (confirm == true)
        {
            try
            {
                await VoucherService.FinalizeVoucherAsync(id);
                Snackbar.Add("سند نهایی شد.", Severity.Success);
                await _table.ReloadServerData();
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }
}