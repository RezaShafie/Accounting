@page "/"

@inject NavigationManager NavManager
@inject IVoucherService VoucherService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudTable T="VoucherDto"
              ServerData="@ServerReload"
              Dense="true"
              Hover="true"
              Striped="true"
              @ref="_table"
              Loading="@_loading"
              LoadingProgressColor="Color.Info">

        <ToolBarContent>
            <MudText Typo="Typo.h6">اسناد حسابداری</MudText>
            <MudSpacer />
            <MudTextField T="string" ValueChanged="@(s => OnSearch(s))"
                          Placeholder="جستجو..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Medium"
                          Class="mt-0"
                          Immediate="true"
                          DebounceInterval="500"></MudTextField>
            <MudSpacer />
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="ms-3"
                       OnClick="@(() => NavManager.NavigateTo("/vouchers/create"))">
                سند جدید
            </MudButton>
        </ToolBarContent>

        <HeaderContent>
            <MudTh>شماره</MudTh>
            <MudTh>تاریخ</MudTh>
            <MudTh>شرح</MudTh>
            <MudTh>وضعیت</MudTh>
            <MudTh>عملیات</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="شماره">@context.VoucherNumber</MudTd>
            <MudTd DataLabel="تاریخ">@context.Date</MudTd>
            <MudTd DataLabel="شرح">@context.Description</MudTd>
            <MudTd DataLabel="وضعیت">
                @if (context.IsFinalized)
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small">قطعی</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Warning" Size="Size.Small">پیش‌نویس</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="عملیات">
                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Size="Size.Small"
                               Color="Color.Info"
                               OnClick="@(() => NavManager.NavigateTo($"/vouchers/edit/{context.Id}"))" />

                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Size="Size.Small"
                               Color="Color.Error"
                               OnClick="@(() => DeleteVoucher(context.Id, (int)context.VoucherNumber))" />

                <MudIconButton Icon="@Icons.Material.Filled.CheckCircle"
                               Size="Size.Small"
                               Color="Color.Success"
                               OnClick="@(() => FinalizeVoucher(context.Id))" />
            </MudTd>
        </RowTemplate>

        <NoRecordsContent>
            <MudText>هیچ سندی یافت نشد.</MudText>
        </NoRecordsContent>

        <LoadingContent>
            <MudText>در حال بارگذاری اطلاعات...</MudText>
        </LoadingContent>

        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }"
                           InfoFormat="{first_item}-{last_item} از {all_items}" />
        </PagerContent>
    </MudTable>
</MudContainer>

@code {
    private MudTable<VoucherDto> _table;
    private string _searchString = "";
    private bool _loading = true;

    private async Task<TableData<VoucherDto>> ServerReload(TableState state, CancellationToken token)
    {
        _loading = true;
        try
        {
            var pageNumber = state.Page + 1;
            var pageSize = state.PageSize;

            var result = await VoucherService.GetVouchersAsync(pageNumber, pageSize);

            return new TableData<VoucherDto>()
            {
                TotalItems = result.TotalCount,
                Items = result.Items
            };
        }
        catch (Exception ex)
        {
            // 1. Error Snackbar for loading failures
            Snackbar.Add(ex.Message, Severity.Error);
            return new TableData<VoucherDto>() { TotalItems = 0, Items = new List<VoucherDto>() };
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task DeleteVoucher(Guid id, int voucherNumber)
    {
        var confirm = await DialogService.ShowMessageBox(
            "حذف سند",
            $"آیا از حذف سند شماره {voucherNumber} اطمینان دارید؟",
            yesText: "بله", cancelText: "خیر");

        if (confirm == true)
        {
            try
            {
                await VoucherService.DeleteVoucherAsync(id);

                Snackbar.Add("سند با موفقیت حذف شد.", Severity.Success);

                await _table.ReloadServerData();
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }
    private async Task FinalizeVoucher(Guid id)
    {
        var confirm = await DialogService.ShowMessageBox(
            "نهایی سازی",
            $"آیا از نهایی سازی سند اطمینان دارید",
            yesText: "بله", cancelText: "خیر");

        if (confirm == true)
        {
            try
            {
                await VoucherService.FinalizeVoucherAsync(id);

                Snackbar.Add("سند نهایی شد.", Severity.Success);

                await _table.ReloadServerData();
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }

    private void OnSearch(string text)
    {
        _searchString = text;
        _table.ReloadServerData();
    }
}