@page "/not-found"
@inject NavigationManager NavManager

<MudContainer MaxWidth="MaxWidth.Medium" Class="d-flex flex-column align-center justify-center" Style="height: 80vh;">

    <MudIcon Icon="@Icons.Material.TwoTone.SearchOff"
             Color="Color.Default"
             Style="width: 120px; height: 120px; opacity: 0.5;"
             Class="mb-4" />

    <MudText Typo="Typo.h1" Color="Color.Primary" Style="font-weight: 900; font-size: 6rem;">
        404
    </MudText>

    <MudText Typo="Typo.h4" Class="mb-2" Align="Align.Center">
        صفحه مورد نظر پیدا نشد!
    </MudText>

    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-8" Align="Align.Center">
        متاسفیم، اما آدرسی که به دنبال آن هستید وجود ندارد یا حذف شده است.
    </MudText>

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               Size="Size.Large"
               StartIcon="@Icons.Material.Filled.Home"
               OnClick="GoHome">
        بازگشت به اسناد
    </MudButton>

</MudContainer>

@code {
    private void GoHome() => NavManager.NavigateTo("/");
}