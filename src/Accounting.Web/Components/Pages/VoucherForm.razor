@using FluentValidation
@using Accounting.Web.Validators
@using Severity = MudBlazor.Severity

<MudForm Model="@Model" @ref="_form" Validation="@(ValidateValue)" ValidationDelay="0">

    <MudGrid>
        <MudItem xs="12" sm="4">
            <MudNumericField @bind-Value="Model.VoucherNumber"
                             Label="شماره سند"
                             Variant="Variant.Outlined"
                             For="@(() => Model.VoucherNumber)" />
        </MudItem>

        <MudItem xs="12" sm="4">
            <MudDatePicker Date="@(Model.Date.ToDateTime(TimeOnly.MinValue))"
                           DateChanged="@(d => Model.Date = DateOnly.FromDateTime(d!.Value))"
                           Label="تاریخ سند"
                           Variant="Variant.Outlined"/>
        </MudItem>

        <MudItem xs="12" sm="12">
            <MudTextField @bind-Value="Model.Description"
                          Label="شرح سند"
                          Variant="Variant.Outlined"
                          For="@(() => Model.Description)" />
        </MudItem>
    </MudGrid>

    <MudDivider Class="my-4" />

    <MudTable Items="@Model.Lines" Dense="true" Hover="true" Striped="true">
        <HeaderContent>
            <MudTh>کد حساب</MudTh>
            <MudTh>شرح</MudTh>
            <MudTh>بدهکار</MudTh>
            <MudTh>بستانکار</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate Context="line">
            <MudTd>
                <MudTextField @bind-Value="line.AccountCode" 
                              For="@(() => line.AccountCode)"
                              Validation="@((object x, string p) => ValidateLine(line, p))" 
                              Placeholder="xxxx-xxxx-xxxx" />
            </MudTd>
            <MudTd>
                <MudTextField @bind-Value="line.Description" 
                              For="@(() => line.Description)" 
                              Validation="@((object x, string p) => ValidateLine(line, p))" />
            </MudTd>
            <MudTd>
                <MudNumericField @bind-Value="line.Debit" 
                                 For="@(() => line.Debit)"
                                 Validation="@((object x, string p) => ValidateLine(line, p))"
                                 HideSpinButtons="true" />
            </MudTd>
            <MudTd>
                <MudNumericField @bind-Value="line.Credit" 
                                 For="@(() => line.Credit)"
                                 Validation="@((object x, string p) => ValidateLine(line, p))"
                                 HideSpinButtons="true" />
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                               Color="Color.Error" 
                               OnClick="@(() => RemoveLine(line))" />
            </MudTd>
        </RowTemplate>
    </MudTable>

    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="AddLine" Class="mt-2">
        افزودن سطر
    </MudButton>

    @if (_form.Errors.Any())
    {
        <MudAlert Severity="Severity.Error" Class="mt-3">
            @foreach (var err in _form.Errors)
            {
                <MudText>@err</MudText>
            }
        </MudAlert>
    }

    <MudStack Row="true" Class="mt-4 justify-end">
        <MudButton OnClick="OnCancel" Variant="Variant.Text">انصراف</MudButton>
        <MudButton Disabled="@IsBusy" OnClick="Submit" Variant="Variant.Filled" Color="Color.Primary">
            @if (IsBusy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
            }
            else
            {
                <text>ثبت سند</text>
            }
        </MudButton>
    </MudStack>

</MudForm>

@code {
    [Parameter] public VoucherDto Model { get; set; } = new();
    [Parameter] public EventCallback OnValidSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public bool IsEditMode { get; set; }
    [Parameter] public bool IsBusy { get; set; }

    private MudForm _form;

    private VoucherValidator _voucherValidator = new();

    // 2. Validator for the Children (Table Rows)
    private VoucherLineValidator _lineValidator = new();

    private void AddLine()
    {
        Model.Lines.Add(new VoucherLineDto());
    }

    private void RemoveLine(VoucherLineDto line)
    {
        Model.Lines.Remove(line);
    }

    private async Task Submit()
    {
        await _form.Validate();

        if (_form.IsValid)
        {
            await OnValidSubmit.InvokeAsync();
        }
    }

    private async Task<IEnumerable<string>> ValidateValue(object model, string propertyName)
    {
        var result = await _voucherValidator.ValidateAsync(
            ValidationContext<VoucherDto>.CreateWithOptions((VoucherDto)model, x => x.IncludeProperties(propertyName)));
        
        if (result.IsValid) return Array.Empty<string>();
        return result.Errors.Select(e => e.ErrorMessage);
    }

    private async Task<IEnumerable<string>> ValidateLine(VoucherLineDto lineModel, string propertyName)
    {
        var result = await _lineValidator.ValidateAsync(
            ValidationContext<VoucherLineDto>.CreateWithOptions(lineModel, x => x.IncludeProperties(propertyName)));
    
        if (result.IsValid)
            return Array.Empty<string>();
        
        return result.Errors.Select(e => e.ErrorMessage);
    }
}